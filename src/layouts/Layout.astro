---
interface Props {
  title?: string;
}
const { title = "Invitación de Bautizo" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
	<link
		href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@400;600;700&family=Parisienne&family=Raleway:wght@400;500&display=swap"
		rel="stylesheet"
	/>
	<link
		href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Great+Vibes&family=Montserrat:wght@400;600;700&family=Parisienne&family=Raleway:wght@400;500&display=swap"
		rel="stylesheet"
	/>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --rosa-fondo: #fdf0f3;
    --rosa-circulo: #ffc5d3;
    --rosa-texto: #f0475f;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    font-family: "Montserrat", sans-serif;
    background: var(--rosa-fondo);
    color: var(--rosa-texto);
  }
</style>