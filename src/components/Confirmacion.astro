---
// ✏️ Edita aquí tus datos
const datos = {
  titulo: "Confirma tu Asistencia",
  texto: "Tu presencia hará este día aún más especial. Por favor confirma tu asistencia.",
  fechaLimite: "Fecha límite para confirmar: 5 de noviembre",
  // Número de WhatsApp en formato internacional, SIN "+", espacios ni guiones
  // México: 52 + 10 dígitos
  telefono: "528129097127",
  festejada: "Lucia",
  fechaEvento: "07 de noviembre de 2026",
  maxInvitados: 5,
  imagen: "/images/paloma-flores.png",
};
---

<section
  class="rsvp"
  data-telefono={datos.telefono}
  data-festejada={datos.festejada}
  data-fecha-evento={datos.fechaEvento}
>
  <div class="contenedor">
    <img
      class="ornamento anim anim--zoom"
      src={datos.imagen}
      alt="Paloma y flores"
      loading="lazy"
    />

    <h2 class="titulo anim anim--arriba">{datos.titulo}</h2>
    <p class="texto anim anim--arriba" style="--delay: 0.1s">{datos.texto}</p>
    <p class="limite anim anim--arriba" style="--delay: 0.2s">{datos.fechaLimite}</p>

    <form class="formulario anim anim--arriba" style="--delay: 0.3s" novalidate>
      <label class="campo">
        <span>Tu nombre</span>
        <input
          type="text"
          name="nombre"
          placeholder="Nombre y apellido"
          autocomplete="name"
          required
        />
      </label>

      <label class="campo">
        <span>Número de personas</span>
        <select name="personas">
          {
            Array.from({ length: datos.maxInvitados }, (_, i) => i + 1).map((n) => (
              <option value={n}>{n} {n === 1 ? "persona" : "personas"}</option>
            ))
          }
        </select>
      </label>

      <label class="campo">
        <span>Mensaje (opcional)</span>
        <textarea name="mensaje" rows="3" placeholder="Escribe un mensaje o una nota"></textarea>
      </label>

      <p class="error" role="alert" hidden>Por favor escribe tu nombre.</p>

      <div class="botones">
        <button type="submit" class="boton boton--si">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M20.5 3.5A11.8 11.8 0 0 0 12 0C5.4 0 0 5.4 0 12c0 2.1.6 4.200 1.600 6L0 24l6.200-1.600A12 12 0 0 0 12 24c6.600 0 12-5.400 12-12 0-3.200-1.200-6.200-3.500-8.500zM12 22a10 10 0 0 1-5.100-1.400l-.4-.2-3.700 1 1-3.600-.2-.4A10 10 0 1 1 12 22zm5.500-7.500c-.3-.1-1.800-.9-2-1s-.5-.1-.7.100-.8 1-1 1.200-.4.200-.7.100a8.200 8.200 0 0 1-4.100-3.600c-.3-.5.300-.5.900-1.600.1-.2 0-.4 0-.5l-1-2.300c-.2-.6-.5-.5-.7-.5h-.6a1.200 1.200 0 0 0-.9.400 3.800 3.800 0 0 0-1.200 2.800 6.600 6.600 0 0 0 1.400 3.500 15 15 0 0 0 5.800 5.100c2.100.9 2.900.9 3.900.8a3.300 3.300 0 0 0 2.200-1.600 2.700 2.700 0 0 0 .2-1.600c-.1-.1-.3-.2-.6-.3z" />
          </svg>
          Confirmar asistencia
        </button>
        <button type="button" class="boton boton--no" data-no>
          No podré asistir
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .rsvp {
    --rosa: #f0475f;
    --azul: #4a6382;
    background: #fff0f3;
    padding: 5rem 1.25rem 6rem;
    overflow: hidden;
  }

  .contenedor {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ornamento {
    width: min(55%, 240px);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .titulo {
    margin: 0 0 1rem;
    font-family: "Parisienne", cursive;
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 3.4rem);
    color: var(--rosa);
  }

  .texto {
    margin: 0 0 0.8rem;
    font-family: "Raleway", sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--azul);
  }

  .limite {
    margin: 0 0 2rem;
    font-family: "Cormorant Garamond", serif;
    font-weight: 600;
    font-size: 1.15rem;
    color: #c99a62;
  }

  .formulario {
    width: 100%;
    padding: 2rem 1.5rem;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 35px rgba(240, 71, 95, 0.12);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: "Raleway", sans-serif;
    font-size: 0.9rem;
    color: var(--azul);
  }

  .campo input,
  .campo select,
  .campo textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1.5px solid #ffc9d0;
    border-radius: 10px;
    background: #fffafb;
    font-family: inherit;
    font-size: 1rem;
    color: #2d3448;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .campo textarea {
    resize: vertical;
  }
  .campo input:focus,
  .campo select:focus,
  .campo textarea:focus {
    outline: none;
    border-color: var(--rosa);
    box-shadow: 0 0 0 3px rgba(240, 71, 95, 0.15);
  }

  .error {
    margin: -0.4rem 0 0;
    font-family: "Raleway", sans-serif;
    font-size: 0.85rem;
    color: #d62839;
  }

  .botones {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.2rem;
    border-radius: 999px;
    border: 2px solid transparent;
    font-family: "Raleway", sans-serif;
    font-weight: 500;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .boton:hover {
    transform: translateY(-2px);
  }
  .boton--si {
    background: #25d366;
    color: #fff;
  }
  .boton--si:hover {
    background: #1ebe5a;
  }
  .boton--no {
    background: transparent;
    border-color: var(--rosa);
    color: var(--rosa);
  }
  .boton--no:hover {
    background: var(--rosa);
    color: #fff;
  }

  /* ---- Transiciones de entrada ---- */
  .anim {
    opacity: 0;
    transition:
      opacity 0.9s ease-out var(--delay, 0s),
      transform 0.9s ease-out var(--delay, 0s);
  }
  .anim--arriba {
    transform: translateY(40px);
  }
  .anim--zoom {
    transform: scale(0.8);
  }
  .anim.activo {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .anim {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>(".rsvp");

  if (seccion) {
    // 1) Entrada animada
    const observer = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("activo");
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    seccion.querySelectorAll(".anim").forEach((el) => observer.observe(el));

    // 2) Envío por WhatsApp
    const { telefono, festejada, fechaEvento } = seccion.dataset;
    const form = seccion.querySelector<HTMLFormElement>("form")!;
    const error = seccion.querySelector<HTMLElement>(".error")!;
    const btnNo = seccion.querySelector<HTMLButtonElement>("[data-no]")!;

    function abrirWhatsApp(asistira: boolean) {
      const datos = new FormData(form);
      const nombre = String(datos.get("nombre") ?? "").trim();
      const personas = Number(datos.get("personas") ?? 1);
      const nota = String(datos.get("mensaje") ?? "").trim();

      if (!nombre) {
        error.hidden = false;
        form.querySelector<HTMLInputElement>("[name=nombre]")?.focus();
        return;
      }
      error.hidden = true;

      let texto = asistira
        ? `¡Hola! Soy ${nombre}. Confirmo mi asistencia al bautizo de ${festejada} el ${fechaEvento}, ` +
          `somos ${personas} ${personas === 1 ? "persona" : "personas"}.`
        : `¡Hola! Soy ${nombre}. Lamentablemente no podré asistir al bautizo de ${festejada} el ${fechaEvento}.`;

      if (nota) texto += `\n\nMensaje: ${nota}`;

      const url = `https://wa.me/${telefono}?text=${encodeURIComponent(texto)}`;
      window.open(url, "_blank", "noopener,noreferrer");
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      abrirWhatsApp(true);
    });
    btnNo.addEventListener("click", () => abrirWhatsApp(false));
  }
</script>